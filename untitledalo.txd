-- ========== HELPERS ==========
local function GetAliveChar(player)
    if not player then return nil end
    local char = player.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    return char
end

local function IsValidTarget(player)
    if player == LocalPlayer then return false end
    local char = GetAliveChar(player)
    if not char then return false end
    local head = char:FindFirstChild("Head")
    if not head then return false end

    if Config.TeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return false
    end

    if Config.WallCheck then
        local ok, hit = pcall(function()
            local ray = Ray.new(Camera.CFrame.Position, (head.Position - Camera.CFrame.Position).Unit * 500)
            return Workspace:FindPartOnRay(ray, LocalPlayer.Character)
        end)
        if ok and hit and not hit:IsDescendantOf(char) then return false end
    end
    return true
end

local function GetClosestHead(fov)
    local closest, shortest = nil, fov or Config.AimFOV
    local mx, my = Mouse.X, Mouse.Y
    for _, player in pairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            local head = player.Character.Head
            local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - Vector2.new(mx, my)).Magnitude
                if d < shortest then
                    shortest = d
                    closest = head
                end
            end
        end
    end
    return closest
end

local function GetClosestFromCenter(fov)
    local best, bestDist = nil, fov or math.huge
    local vp = Camera.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    for _, player in pairs(Players:GetPlayers()) do
        if IsValidTarget(player) then
            local head = player.Character.Head
            local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = head
                end
            end
        end
    end
    return best
end

-- ========== NOCLIP ==========
local noclipConn = nil
local function ApplyNoclip()
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    noclipConn = RunService.Stepped:Connect(Safe(function()
        if not Config.Noclip then return end
        local char = LocalPlayer.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end))
end

-- ========== WALLBANG (FIX CRASH) ==========
local wallbangConn = nil
local originalData = {}

local function RestorePart(part, data)
    if part and part.Parent then
        pcall(function()
            part.Size = data.Size
            part.CanCollide = data.CanCollide
            part.Transparency = data.Transparency
        end)
    end
end

local function RemoveWallbang()
    if wallbangConn then
        pcall(function() wallbangConn:Disconnect() end)
        wallbangConn = nil
    end
    for part, data in pairs(originalData) do
        RestorePart(part, data)
    end
    originalData = {}
end

local function ApplyWallbang()
    RemoveWallbang()
    wallbangConn = RunService.Heartbeat:Connect(Safe(function()
        if not Config.Wallbang then return end
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local char = p.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if not originalData[part] then
                                originalData[part] = {
                                    Size = part.Size,
                                    CanCollide = part.CanCollide,
                                    Transparency = part.Transparency,
                                }
                            end
                            local d = originalData[part]
                            if part.Name == "Head" then
                                part.Size = Vector3.new(2.5, 2.5, 2.5)
                            else
                                part.Size = d.Size * 1.3
                            end
                            part.CanCollide = false
                            part.Transparency = math.max(d.Transparency, 0.85)
                        end
                    end
                end
            end
        end
    end))
end

-- ========== ESP ==========
local espCache = {}
local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = GetAliveChar(player)
            if Config.ESP and char then
                if not espCache[player] then
                    local h = Instance.new("Highlight")
                    h.Name = "RivalsESP"
                    h.FillColor = Theme.Red
                    h.FillTransparency = 0.55
                    h.OutlineColor = Color3.fromRGB(255, 255, 255)
                    h.OutlineTransparency = 0
                    h.Parent = char
                    espCache[player] = h
                    -- gắn sự kiện xóa khi char đổi
                    AddConn(char.AncestryChanged:Connect(Safe(function()
                        if not char:IsDescendantOf(Workspace) then
                            espCache[player] = nil
                        end
                    end)))
                elseif espCache[player].Parent ~= char then
                    espCache[player]:Destroy()
                    espCache[player] = nil
                end
            elseif not Config.ESP and espCache[player] then
                pcall(function() espCache[player]:Destroy() end)
                espCache[player] = nil
            end
        end
    end
end

-- ========== SILENT AIM (SAFE, KHÔNG HOOK __namecall) ==========
-- Dùng hook __index an toàn bằng setreadonly
local silentTarget = nil

local function TryHookSilentAim()
    local ok = pcall(function()
        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            if Config.SilentAim and silentTarget and silentTarget.Parent then
                if self == Mouse then
                    if key == "Hit" then
                        return CFrame.new(Camera.CFrame.Position, silentTarget.Position)
                    elseif key == "Target" then
                        return silentTarget
                    end
                end
            end
            return oldIndex(self, key)
        end)
    end)
    if not ok then
        warn("[ToanBaKhi] Silent Aim cần executor hỗ trợ hookmetamethod")
    end
end

-- Chỉ hook __index (an toàn hơn __namecall rất nhiều)
TryHookSilentAim()

-- ========== MAIN LOOP ==========
AddConn(RunService.RenderStepped:Connect(Safe(function()
    -- Silent Aim target
    if Config.SilentAim then
        silentTarget = GetClosestFromCenter(Config.SilentFOV)
    else
        silentTarget = nil
    end

    -- ESP
    UpdateESP()

    -- Aim Assist / Head Aimbot (chỉ khi giữ chuột phải)
    if UIS:IsMouseButtonPressed(Config.AimKey) then
        local target = GetClosestHead(Config.AimFOV)
        if target then
            local smooth = Config.HeadAimbot and Config.HeadSmoothness or Config.AimSmoothness
            local cur = Camera.CFrame
            local new = CFrame.new(cur.Position, target.Position)
            Camera.CFrame = cur:Lerp(new, smooth)
        end
    end

    -- Camera Lock
    if Config.CameraLock then
        local head = GetClosestHead(Config.AimFOV)
        if head then
            local cur = Camera.CFrame
            local new = CFrame.new(cur.Position, head.Position)
            Camera.CFrame = cur:Lerp(new, Config.CameraSmooth)
        end
    end

    -- Aim Magic
    if Config.AimMagic then
        local best = GetClosestFromCenter(Config.AimFOV)
        if best then
            local cur = Camera.CFrame
            local new = CFrame.new(cur.Position, best.Position)
            Camera.CFrame = cur:Lerp(new, 0.5)
        end
    end
end)))

-- ========== KEYBIND ==========
AddConn(UIS.InputBegan:Connect(Safe(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.N then
        Config.Noclip = not Config.Noclip
        if Config.Noclip then ApplyNoclip() end
        print("👻 Noclip: " .. (Config.Noclip and "ON" or "OFF"))
    end
end)))

-- ========== CHARACTER RESPAWN ==========
AddConn(LocalPlayer.CharacterAdded:Connect(Safe(function()
    task.wait(1)
    if Config.Noclip then ApplyNoclip() end
    if Config.Wallbang then ApplyWallbang() end
end)))

-- ========== PLAYER CLEANUP ==========
AddConn(Players.PlayerRemoving:Connect(Safe(function(p)
    if espCache[p] then
        pcall(function() espCache[p]:Destroy() end)
        espCache[p] = nil
    end
end)))

-- ========== AUTO CLEANUP KHI SCRIPT DỪNG ==========
-- (không có cách chuẩn để detect executor stop,
--  nhưng DisconnectAll() sẽ chạy khi bấm Close)
game:BindToClose(Safe(function()
    DisconnectAll()
    RemoveWallbang()
    pcall(function() ScreenGui:Destroy() end)
end))

print("⚔️ TOÀN BÁ KHÍ v7 loaded! ANTI-CRASH 💀")
print("⚡ Silent Aim | ✨ Aim Magic | 📷 Camera Lock")
print("📌 Phím N = Noclip | Bấm × = dừng script sạch")