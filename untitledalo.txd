--[[
    ⚔️ TOÀN BÁ KHÍ - Rivals Script v7
    Silent Aim + Aim Magic + Camera Lock + Noclip + Wallbang
    ⚠️ ANTI-CRASH: pcall toàn bộ, không hook nguy hiểm, cleanup sạch
    Dành cho mục đích học tập
]]

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local Workspace    = game:GetService("Workspace")
local UIS          = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Camera       = Workspace.CurrentCamera
local LocalPlayer  = Players.LocalPlayer
local Mouse        = LocalPlayer:GetMouse()

-- ========== SAFE WRAPPER ==========
local function Safe(fn)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then warn("[ToanBaKhi] " .. tostring(err)) end
    end
end

-- ========== CONFIG ==========
local Config = {
    AimAssist      = true,
    HeadAimbot     = false,
    AimMagic       = false,
    CameraLock     = false,
    SilentAim      = false,
    ESP            = true,
    Noclip         = false,
    Wallbang       = false,
    AimFOV         = 250,
    AimSmoothness  = 0.3,
    HeadSmoothness = 0.5,
    CameraSmooth   = 0.25,
    SilentFOV      = 300,
    TeamCheck      = true,
    WallCheck      = false,
    AimKey         = Enum.UserInputType.MouseButton2,
}

-- ========== THEME ==========
local Theme = {
    Bg         = Color3.fromRGB(18, 18, 24),
    Panel      = Color3.fromRGB(28, 28, 38),
    PanelHover = Color3.fromRGB(38, 38, 52),
    Accent     = Color3.fromRGB(138, 92, 255),
    Accent2    = Color3.fromRGB(255, 92, 180),
    Green      = Color3.fromRGB(0, 220, 130),
    Red        = Color3.fromRGB(255, 80, 80),
    Text       = Color3.fromRGB(240, 240, 255),
    SubText    = Color3.fromRGB(150, 150, 180),
    Stroke     = Color3.fromRGB(60, 60, 85),
}

-- ========== CLEANUP TRACKING ==========
local Connections = {}
local function AddConn(conn)
    table.insert(Connections, conn)
    return conn
end

local function DisconnectAll()
    for _, c in pairs(Connections) do
        pcall(function() c:Disconnect() end)
    end
    Connections = {}
end

